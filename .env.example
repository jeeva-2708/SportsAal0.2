# Server & Runtime
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# PostgreSQL 18 Connection
# You can use either DATABASE_URL or the individual PG* fields below.
DATABASE_URL=
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=sportsaal
PGUSER=postgres
PGPASSWORD=your_postgres_password

# Admin Authentication & Security
# Change JWT_SECRET to a long random string before deploying live.
JWT_SECRET=sportsaal_local_dev_jwt_secret_change_me_in_prod
ADMIN_EMAIL=admin@sportsaal.com
ADMIN_NAME=Sportsaal Admin
ADMIN_DEFAULT_PASSWORD=ChangeMe@2026

