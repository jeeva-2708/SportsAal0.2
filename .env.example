# ==========================================
# Sportsaal 3.0 Environment Configuration
# ==========================================

# Server & Runtime (Render automatically populates PORT)
PORT=5000
NODE_ENV=development
# In production on Render serving both SPA & API, set to your custom domain or Render URL, e.g. https://sportsaal.onrender.com
CORS_ORIGIN=http://localhost:5173

# ==========================================
# Database: MySQL / MariaDB (Hostinger / Local)
# ==========================================
# You can use either DATABASE_URL or individual MYSQL_* connection fields.
DATABASE_URL=
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=sportsaal
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_SSL=false

# ==========================================
# File Storage: Supabase Storage
# ==========================================
# When provided, all admin media uploads are stored persistently in Supabase Storage.
# If omitted, uploads fall back to the local uploads/gallery directory.
SUPABASE_URL=https://your-project-id.supabase.co
# Use your Supabase Service Role Key (secret) on the server to permit uploads/deletes.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key
# Name of the public storage bucket (created automatically or create in Supabase dashboard)
SUPABASE_STORAGE_BUCKET=sportsaal-media

# ==========================================
# Admin Authentication & Security
# ==========================================
# Generate a strong 32+ character random string in production
JWT_SECRET=sportsaal_local_dev_jwt_secret_change_me_in_prod
ADMIN_EMAIL=admin@sportsaal.com
ADMIN_NAME=Sportsaal Admin
ADMIN_DEFAULT_PASSWORD=ChangeMe@2026
